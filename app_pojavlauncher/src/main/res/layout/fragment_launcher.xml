<?xml version="1.0" encoding="utf-8"?>
<!-- Ceyo 3 sutunlu ana ekran. MainMenuFragment'in bagladigi tum id'ler korunmustur. -->
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/fragment_menu_main"
	android:layout_width="fill_parent"
	android:layout_height="fill_parent"
	android:background="@color/background_app">

	<androidx.constraintlayout.widget.Guideline
		android:id="@+id/ceyo_g_sidebar"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:orientation="vertical"
		app:layout_constraintGuide_percent="0.2" />
	<androidx.constraintlayout.widget.Guideline
		android:id="@+id/ceyo_g_panel"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:orientation="vertical"
		app:layout_constraintGuide_percent="0.72" />

	<!-- Sag panel arka plani (eski kozmetik view'in id'si korunuyor) -->
	<View
		android:id="@+id/_background_display_view"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:layout_margin="10dp"
		android:background="@drawable/ceyo_panel_bg"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="@id/ceyo_g_panel"
		app:layout_constraintEnd_toEndOf="parent" />

	<!-- SOL: kenar cubugu -->
	<ScrollView
		android:id="@+id/ceyo_sidebar"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:scrollbars="none"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="@id/ceyo_g_sidebar">
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingVertical="10dp">
			<TextView
				android:id="@+id/ceyo_nav_home"
				android:layout_width="match_parent"
				android:layout_height="46dp"
				android:layout_marginHorizontal="8dp"
				android:layout_marginVertical="2dp"
				android:background="@drawable/ceyo_nav_selected"
				android:gravity="start|center_vertical"
				android:paddingHorizontal="14dp"
				android:text="@string/ceyo_home"
				android:textColor="#FFFFFF"
				android:textSize="14sp"
				android:textStyle="bold" />
			<com.kdt.mcgui.LauncherMenuButton
				android:id="@+id/news_button"
				android:visibility="gone"
				style="@style/LauncherMenuButton.Sidebar"
				android:layout_width="match_parent"
				android:text="@string/mcl_tab_wiki"
				android:drawableStart="@drawable/ic_menu_news" />
			<com.kdt.mcgui.LauncherMenuButton
				android:id="@+id/discord_button"
				android:visibility="gone"
				style="@style/LauncherMenuButton.Sidebar"
				android:layout_width="match_parent"
				android:text="@string/mcl_button_discord"
				android:drawableStart="@drawable/ic_discord" />
		</LinearLayout>
	</ScrollView>

	<!-- ORTA: banner + hizli islemler -->
	<ScrollView
		android:id="@+id/ceyo_center"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:scrollbars="none"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="@id/ceyo_g_sidebar"
		app:layout_constraintEnd_toStartOf="@id/ceyo_g_panel">
		<androidx.constraintlayout.widget.ConstraintLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content">
			<androidx.constraintlayout.widget.Guideline
				android:id="@+id/center_guideline"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:orientation="vertical"
				app:layout_constraintGuide_percent="0.5"/>

			<LinearLayout
				android:id="@+id/ceyo_header"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_margin="10dp"
				android:background="@drawable/ceyo_header_bg"
				android:orientation="vertical"
				android:padding="18dp"
				app:layout_constraintTop_toTopOf="parent">
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:background="@drawable/ceyo_pill_bg"
					android:paddingHorizontal="12dp"
					android:paddingVertical="3dp"
					android:text="@string/ceyo_subtitle"
					android:textColor="#FFFFFF"
					android:textSize="11sp"
					android:textStyle="bold" />
				<LinearLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dp"
					android:orientation="horizontal">
					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Cy "
						android:textColor="#FFFFFF"
						android:textSize="28sp"
						android:textStyle="bold" />
					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/ceyo_launcher_word"
						android:textColor="@color/ceyo_accent"
						android:textSize="28sp"
						android:textStyle="bold|italic" />
				</LinearLayout>
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="@string/ceyo_tagline"
					android:textColor="@color/secondary_text"
					android:textSize="13sp" />
			</LinearLayout>

			<TextView
				android:id="@+id/ceyo_quick_title"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="14dp"
				android:layout_marginTop="6dp"
				android:text="@string/ceyo_quick_actions"
				android:textColor="@color/primary_text"
				android:textSize="16sp"
				android:textStyle="bold"
				app:layout_constraintTop_toBottomOf="@id/ceyo_header"
				app:layout_constraintStart_toStartOf="parent" />

			<com.kdt.mcgui.LauncherMenuButton
				android:id="@+id/ceyo_mod_button"
				style="@style/LauncherMenuButton.Universal"
				android:layout_width="0dp"
				android:layout_height="56dp"
				android:drawableStart="@drawable/ic_add_modded"
				android:text="@string/ceyo_mods"
				app:layout_constraintTop_toBottomOf="@id/ceyo_quick_title"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintEnd_toStartOf="@id/center_guideline" />
			<com.kdt.mcgui.LauncherMenuButton
				android:id="@+id/custom_control_button"
				style="@style/LauncherMenuButton.Universal"
				android:layout_width="0dp"
				android:layout_height="56dp"
				android:drawableStart="@drawable/ic_menu_custom_controls"
				android:text="@string/ceyo_controls"
				app:layout_constraintTop_toTopOf="@id/ceyo_mod_button"
				app:layout_constraintStart_toEndOf="@id/center_guideline"
				app:layout_constraintEnd_toEndOf="parent" />
			<com.kdt.mcgui.LauncherMenuButton
				android:id="@+id/install_jar_button"
				style="@style/LauncherMenuButton.Universal"
				android:layout_width="0dp"
				android:layout_height="56dp"
				android:drawableStart="@drawable/ic_menu_install_jar"
				android:text="@string/ceyo_run_jar"
				app:layout_constraintTop_toBottomOf="@id/ceyo_mod_button"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintEnd_toStartOf="@id/center_guideline" />
			<com.kdt.mcgui.LauncherMenuButton
				android:id="@+id/open_files_button"
				style="@style/LauncherMenuButton.Universal"
				android:layout_width="0dp"
				android:layout_height="56dp"
				android:drawableStart="@drawable/ic_folder"
				android:text="@string/ceyo_open_dir"
				app:layout_constraintTop_toTopOf="@id/install_jar_button"
				app:layout_constraintStart_toEndOf="@id/center_guideline"
				app:layout_constraintEnd_toEndOf="parent" />
			<com.kdt.mcgui.LauncherMenuButton
				android:id="@+id/share_logs_button"
				style="@style/LauncherMenuButton.Universal"
				android:layout_width="0dp"
				android:layout_height="56dp"
				android:drawableStart="@android:drawable/ic_menu_share"
				android:text="@string/ceyo_share_logs"
				app:layout_constraintTop_toBottomOf="@id/install_jar_button"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintEnd_toEndOf="parent" />
			<View
				android:id="@+id/social_divider"
				style="@style/LauncherFragment_Divider"
				android:visibility="gone"
				app:layout_constraintTop_toBottomOf="@id/share_logs_button"
				app:layout_constraintStart_toStartOf="parent" />
		</androidx.constraintlayout.widget.ConstraintLayout>
	</ScrollView>

	<!-- SAG: profil, surum secici, oyunu baslat -->
	<TextView
		android:id="@+id/ceyo_version_label"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="20dp"
		android:layout_marginTop="22dp"
		android:text="@string/ceyo_version_label"
		android:textColor="@color/primary_text"
		android:textSize="16sp"
		android:textStyle="bold"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintStart_toStartOf="@id/ceyo_g_panel"
		app:layout_constraintEnd_toEndOf="parent" />

	<com.kdt.mcgui.mcVersionSpinner
		android:id="@+id/mc_version_spinner"
		android:layout_width="0dp"
		android:layout_height="52dp"
		android:layout_marginStart="20dp"
		android:layout_marginEnd="6dp"
		android:layout_marginTop="10dp"
		android:paddingHorizontal="8dp"
		android:background="@drawable/ceyo_card_bg"
		android:drawableEnd="@drawable/spinner_arrow"

		app:drawableEndSize="@dimen/padding_heavy"
		app:drawableStartIntegerScaling="true"
		app:drawableStartSize="36dp"
		app:drawableEndPadding="1dp"

		app:layout_constraintTop_toBottomOf="@id/ceyo_version_label"
		app:layout_constraintStart_toStartOf="@id/ceyo_g_panel"
		app:layout_constraintEnd_toStartOf="@+id/edit_profile_button" />

	<ImageButton
		android:id="@+id/edit_profile_button"
		android:layout_width="44dp"
		android:layout_height="44dp"
		android:layout_marginEnd="20dp"
		android:background="?android:attr/selectableItemBackground"
		android:src="@drawable/ic_edit_profile"
		app:layout_constraintTop_toTopOf="@id/mc_version_spinner"
		app:layout_constraintBottom_toBottomOf="@id/mc_version_spinner"
		app:layout_constraintEnd_toEndOf="parent" />

	<com.kdt.mcgui.MineButton
		android:id="@+id/play_button"
		android:layout_width="0dp"
		android:layout_height="54dp"
		android:layout_marginHorizontal="20dp"
		android:layout_marginBottom="22dp"
		android:textAllCaps="false"
		android:text="@string/ceyo_play"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="@id/ceyo_g_panel"
		app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
